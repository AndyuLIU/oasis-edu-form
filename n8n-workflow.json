      "name": "查詢員工",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_CREDENTIAL_ID",
          "name": "Notion API"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const wh = $('Webhook').item.json;\nconst results = $input.first().json.results;\nconst employeeId = results?.[0]?.id ?? null;\n\nconst props = {\n  '名稱': {\n    title: [{ text: { content: `${wh.name} · ${wh.courseDate}` } }]\n  },\n  '設計師': {\n    rich_text: [{ text: { content: wh.name } }]\n  },\n  '課程日期': {\n    date: { start: wh.courseDate }\n  },\n  '主辦單位': {\n    rich_text: [{ text: { content: wh.organizer } }]\n  },\n  '費用': {\n    number: Number(wh.estimatedFee)\n  },\n  '備註': {\n    rich_text: [{ text: { content: wh.notes || '' } }]\n  },\n  'Line UID': {\n    rich_text: [{ text: { content: wh.lineUserId } }]\n  },\n  '送出時間': {\n    date: { start: wh.submittedAt }\n  }\n};\n\nif (employeeId) {\n  props['員工'] = { relation: [{ id: employeeId }] };\n}\n\nreturn [{\n  json: {\n    parent: { database_id: 'REPLACE_EDU_REPORT_DB_ID' },\n    properties: props\n  }\n}];"
      },
