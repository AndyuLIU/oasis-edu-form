        "jsCode": "const wh = $('Webhook').item.json;\nreturn [{\n  json: {\n    filter: {\n      property: 'Line UID',\n      rich_text: { equals: wh.lineUserId }\n    },\n    page_size: 1\n  }\n}];"
      },
